# LLM servisinin kendi anahtarları. Bu dosyayı .env olarak kopyalayıp doldurun.
# Anahtarlar kuyruğa veya ana projeye hiç gönderilmez.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=true
OPENROUTER_MODELS=
OPENROUTER_SHARE=0.2
# Yazım yardımcısı: kaynak belgelerin anlamsal araması için embedding (Gemini). Boş bırakılırsa yalnız anahtar kelime araması yapılır.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
# Bu dosyadaki anahtarlar salt okunur başlangıç anahtarlarıdır (virgülle birden çok değer yazılabilir).
# Daha fazla anahtar Yönetim → API anahtarları sayfasından eklenir; llm-data biriminde (LLM_DATA_DIR) şifreli saklanır.
