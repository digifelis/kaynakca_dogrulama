# Optional; copy to .env and add your own keys. Never share .env.
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=
OPENALEX_API_KEY=
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
GOOGLE_BOOKS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# false yapıldığında API anahtarı dosyada kalsa bile OpenRouter kullanılmaz.
OPENROUTER_ENABLED=true
# Virgülle ayrılmış yedek model sırası. İlk iki model yapılandırılmış JSON çıktısını destekler.
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-content-safety:free
# İsteklerin varsayılan olarak %20'sini OpenRouter'a gönderir; Groq 429/5xx durumunda ayrıca yedek olarak kullanılır.
OPENROUTER_SHARE=0.2
# Türkçe atıf/İngilizce yayın gibi dil farklarında arama terimlerini LLM ile çevirir (bölüm başına istek sayısını azaltır).
CONTENT_QUERY_EXPANSION=true
