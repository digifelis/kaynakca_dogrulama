# Optional; copy to .env and add your own keys. Never share .env.
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=
OPENALEX_API_KEY=
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
GOOGLE_BOOKS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# false yapıldığında API anahtarı dosyada kalsa bile OpenRouter kullanılmaz.
OPENROUTER_ENABLED=true
# Virgülle ayrılmış yedek model sırası. İlk iki model yapılandırılmış JSON çıktısını destekler.
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-content-safety:free
# İsteklerin varsayılan olarak %20'sini OpenRouter'a gönderir; Groq 429/5xx durumunda ayrıca yedek olarak kullanılır.
OPENROUTER_SHARE=0.2
# Türkçe atıf/İngilizce yayın gibi dil farklarında arama terimlerini LLM ile çevirir (bölüm başına istek sayısını azaltır).
CONTENT_QUERY_EXPANSION=true

# --- Hesaplar ve yönetim paneli (web sunucusu) ---
# Dışarıdan görünen adres: e-posta bağlantıları ve Secure çerez için (TLS ters vekil kullanıyorsanız verin).
PUBLIC_URL=
# Docker port yayını adresi (docker-compose.yml). Varsayılan 127.0.0.1: yalnız sunucunun kendisi erişir.
# Nginx sunucunun IP'si üzerinden bağlanıyorsa (proxy_pass http://10.1.2.116:4173) o IP'yi yazın; 0.0.0.0 tüm arayüzleri açar.
WEB_BIND=
QUEUE_BIND=
# localhost dışındaki ek ana bilgisayar adları (virgülle).
ALLOWED_HOSTS=
# Ters vekil arkasında istemci IP'si için 1.
TRUST_PROXY=
# LDAP/SMTP parolalarını şifreleyen anahtar; boşsa data/writer/settings.secret dosyası üretilir.
SETTINGS_SECRET=
# İlk yönetici hesabı (boşsa admin@admin.com / admin; ilk girişte parola değişimi zorunlu).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# GROQ_API_KEY / OPENROUTER_API_KEY / GEMINI_API_KEY için virgülle birden çok anahtar yazabilirsiniz (KEY1,KEY2).
# Daha fazlası Yönetim → API anahtarları sayfasından eklenir (LLM_DATA_DIR içinde şifreli saklanır).
# ---- Hız ve token ayarları (hepsi isteğe bağlı; varsayılanlar iyidir)
# İçerik kontrolünde uzun yayınların bölümlerini önce ucuz bir model eler (false: kapatır).
CONTENT_SCREENING=
GROQ_SCREEN_MODEL=
# Yerel kaynakça doğrulamasında aynı anda doğrulanan kayıt sayısı (1-8, varsayılan 3).
VERIFY_LOCAL_PARALLEL=
# Yazım yardımcısı: aynı anda okunan dosya (varsayılan 2) ve aynı anda embedding alan belge (varsayılan 3).
WRITER_PROCESS_PARALLEL=
WRITER_EMBED_PARALLEL=
# Kalıcı Python işçileri: sayı (varsayılan 2, 0 = her istekte yeni süreç) ve kaç istekte bir yenilenecekleri (varsayılan 100).
PYTHON_POOL=
PYTHON_RECYCLE=
# Ortak önbellek: false kapatır; en büyük boyut MB (varsayılan 2048); CACHE_VERSION değişince eski kayıtlar geçersiz olur.
CACHE_ENABLED=
CACHE_MAX_MB=
CACHE_VERSION=

# ---- Raporlar (Yönetim paneli > Raporlar): performans ve kullanıcı deneyimi ölçümleri, hepsi isteğe bağlı
# false ölçümü kapatır. Veri data/writer/metrics.db dosyasında tutulur (METRICS_DIR ile başka klasör).
METRICS_ENABLED=
METRICS_DIR=
# Kayıtların saklanma süresi, gün (varsayılan 90; süreç örnekleri en çok 30 gün).
METRICS_RETENTION_DAYS=
# Hızlı ve başarılı API isteklerinin kaçta biri kaydedilsin (varsayılan 10; sayımlar ağırlıkla düzeltilir). Hatalar ve yavaş istekler hep kaydedilir. 1 = hepsi.
METRICS_SAMPLE=
# Apdex "memnun" eşiği, ms (varsayılan 500) ve model cevabının "yavaş" sayıldığı süre, ms (varsayılan 30000).
APDEX_T_MS=
REPORT_LLM_SLOW_MS=
